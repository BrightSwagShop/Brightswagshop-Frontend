<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BrightSwagShop</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        color: #222;
      }
      .loading {
        min-height: 100vh;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 2rem;
      }
    </style>
    <script>
      (function () {
        fetch('/index.html', { cache: 'no-store' })
          .then(function (response) {
            return response.text();
          })
          .then(function (html) {
            document.open();
            document.write(html);
            document.close();
          })
          .catch(function () {
            document.body.innerHTML = '<div class="loading"><div><h1>Loading...</h1><p>Please try again.</p></div></div>';
          });
      })();
    </script>
  </head>
  <body>
    <div class="loading">
      <div>
        <h1>Loading...</h1>
        <p>Opening the login page.</p>
      </div>
    </div>
  </body>
</html>